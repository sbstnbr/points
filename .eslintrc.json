{
  "extends": ["react-app", "react-app/jest"],
  "rules": {
    "react/jsx-filename-extension": [1, { "extensions": [".js", ".jsx", ".ts", ".tsx"] }],
    "react/no-array-index-key": 1,
    "react/prop-types": 1,
    "react/react-in-jsx-scope": "off",
    "import/no-unresolved": "off",
    "import/extensions": "off"
  },
  "env": {
    "browser": true,
    "jasmine": true,
    "jest": true
  }
}
